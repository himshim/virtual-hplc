{
  "sdkVersion": "1.0.0",
  "id": "ftir",
  "name": "Fourier-Transform Infrared Spectrometer (FTIR)",
  "category": "Spectroscopy",
  "pluginVersion": "1.0.0",
  "entry": "index.html",
  "requires": {
    "platform": ">=1.0.0",
    "chart": ">=4.0.0"
  },
  "features": {
    "graph": {
      "type": "interferogram",
      "live": true,
      "zoom": true,
      "compare": true
    },
    "education": {
      "prediction": true,
      "notebook": true,
      "replay": false
    },
    "reporting": {
      "export": true
    }
  },
  "contributes": {
    "telemetry": true,
    "hero": "interferogram",
    "toolbar": true,
    "bottomSheet": true
  }
}
